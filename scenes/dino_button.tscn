[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/dino_button.gd" id="1_dino"]
[ext_resource type="PackedScene" path="res://scenes/knight.tscn" id="2_knight"]

[node name="DinoButton" type="Button"]
custom_minimum_size = Vector2(190, 230)
