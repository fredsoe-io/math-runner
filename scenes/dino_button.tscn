[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
alignment = 1

[node name="KnightSlot" type="Control" parent="VBoxContainer"]
custom_minimum_size = Vector2(120, 120)
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2

[node name="Knight" parent="VBoxContainer/KnightSlot" instance=ExtResource("2_knight")]
position = Vector2(55, 72)
scale = Vector2(5, 5)

[node name="NameLabel" type="Label" parent="VBoxContainer"]
