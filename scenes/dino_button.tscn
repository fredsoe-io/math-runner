horizontal_alignment = 1

[node name="SymbolLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "+"
horizontal_alignment = 1

[connection signal="focus_entered" from="." to="." method="_on_hovered"]
[connection signal="mouse_entered" from="." to="." method="_on_hovered"]
