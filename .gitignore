# Godot 4+ specific ignores
.godot/
/android/
.vscode/

# Web export output (keep the .gdignore so the editor never scans the build)
build/*
!build/.gdignore

# macOS
.DS_Store

# The scoreboard key, written by tools/export_web.sh from $SCOREBOARD_KEY.
# It goes into the web build but never into git.
secrets/
